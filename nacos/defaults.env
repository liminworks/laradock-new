# Host ports for the web console & OpenAPI (8848) and gRPC client (9848).
NACOS_HOST_PORT=8848
NACOS_GRPC_HOST_PORT=9848

# Auth secrets are intentionally NOT defaulted here.
# Put them in your root .env (which is gitignored) and generate per deployment:
#   NACOS_AUTH_TOKEN=$(openssl rand -base64 32)
#   NACOS_AUTH_IDENTITY_VALUE=$(openssl rand -hex 32)
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=nacos_server_identity_key
NACOS_AUTH_IDENTITY_VALUE=
